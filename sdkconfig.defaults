# Claude Meter v2 -- minimal config. sdkconfig is generated from this file
# (sdkconfig itself is not committed). ESP-IDF v5.4.4.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_PM_ENABLE=y
# LVGL runs on the main task (rendering + chart masks need headroom)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- LVGL 8.4 ---
# SPI panels want big-endian RGB565; LVGL renders little-endian. Swap in
# LVGL so every color is exact (DEV_KIT E-10 case B). v1 instead
# hand-scrambled its palette, which only worked for saturated colors.
CONFIG_LV_COLOR_16_SWAP=y
# LVGL allocates from the system heap (no fixed 64 KB pool).
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_USE_QRCODE=y

# --- TLS RAM: no PSRAM here, so free mbedTLS buffers after the handshake ---
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# --- PSRAM: the module is an ESP32-S3-WROOM-1 N16R8 (8 MB *octal* PSRAM),
# confirmed by esptool "Embedded PSRAM 8MB (AP_3v3)" 2026-10-02. v1 never
# enabled it. IGNORE_NOTFOUND keeps the device booting if it ever fails.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- Speech recognition (esp-sr): "Jarvis" wake word + English commands ---
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# --- Internal RAM is scarce once esp-sr runs: put TLS + Wi-Fi/LwIP buffers in
# PSRAM, send small mallocs to PSRAM too, keep 48 KB internal for DMA/ISRs.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
